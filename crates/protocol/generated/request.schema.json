    "EventsParams": {
      "type": "object",
      "properties": {
        "after_sequence": {
          "type": "string",
          "pattern": "^(0|[1-9][0-9]{0,18})$"
        },
        "agent_id": {
          "type": "string"
        },
        "capability": {
          "$ref": "#/$defs/Capability"
