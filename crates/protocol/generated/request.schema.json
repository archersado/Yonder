      "type": "object",
      "properties": {
        "agent_id": {
          "type": "string"
        },
        "capability": {
          "$ref": "#/$defs/Capability"
        },
        "deadline": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "expected_sequence": {
          "type": "string"
        },
        "operation": {
          "$ref": "#/$defs/BrowserOperation"
        },
        "task_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "agent_id",
        "capability",
        "deadline",
        "task_id",
        "expected_sequence",
        "operation"
      ]
    },
    "BrowserOperation": {
      "type": "string",
      "enum": [
        "create",
        "observe",
        "hand-off",
        "take-over",
        "finish"
      ]
    },
    "CancelParams": {
