        "offered_capabilities": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "$ref": "#/$defs/OfferedCapability"
          }
        },
        "protocol_version": {
          "$ref": "#/$defs/ProtocolVersion"
        },
        "session_id": {
          "type": [
            "string",
            "null"
