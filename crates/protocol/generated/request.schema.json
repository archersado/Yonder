    "CuaActionKind": {
      "description": "Jev 可辨识的 CUA 动作意图。它描述用户可理解的动作，而非 Driver 工具名或\n具体控件定位；后两者绝不能成为模型选择的依据。",
      "type": "string",
      "enum": [
        "launch-application",
        "bring-to-front",
        "focus-target-search",
        "enter-target-query",
        "activate-target",
        "focus-message-composer",
        "draft-message-ref",
        "resolve-conversation",
        "draft-message",
        "send-message"
      ]
