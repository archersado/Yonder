  "$defs": {
    "ArtifactParams": {
      "type": "object",
      "properties": {
        "after_ordinal": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "agent_id": {
          "type": "string"
        },
        "capability": {
          "$ref": "#/$defs/Capability"
        },
        "deadline": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "limit": {
          "type": "integer",
          "format": "uint8",
          "maximum": 100,
          "minimum": 1
        },
        "manifest_version": {
          "type": "string",
          "pattern": "^[1-9][0-9]{0,18}$"
        },
        "task_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "agent_id",
        "capability",
        "deadline",
        "task_id",
        "manifest_version",
        "after_ordinal",
        "limit"
      ]
    },
