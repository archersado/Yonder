      "type": "object",
      "properties": {
        "after_task_id": {
          "type": [
            "string",
            "null"
          ]
        },
        "agent_id": {
          "type": "string"
        },
        "capability": {
          "$ref": "#/$defs/Capability"
        },
        "deadline": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "include_finished": {
          "type": "boolean",
          "default": false
        },
        "limit": {
          "type": "integer",
          "format": "uint8",
          "maximum": 100,
          "minimum": 1
        },
        "running_only": {
          "type": "boolean",
          "default": false
        }
      },
      "additionalProperties": false,
      "required": [
        "agent_id",
        "capability",
        "deadline",
        "limit"
