{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Response",
  "anyOf": [
    {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "jsonrpc": {
          "$ref": "#/$defs/Version"
        },
        "result": {
          "$ref": "#/$defs/QueryResult"
        }
      },
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "result"
      ]
    },
    {
      "type": "object",
      "properties": {
        "error": {
          "$ref": "#/$defs/RpcError"
        },
        "id": {
          "type": [
            "string",
            "null"
          ]
        },
        "jsonrpc": {
          "$ref": "#/$defs/Version"
        }
      },
      "additionalProperties": false,
      "required": [
        "jsonrpc",
        "id",
        "error"
      ]
    }
  ],
  "$defs": {
    "ArtifactAvailability": {
      "type": "string",
      "enum": [
        "available",
        "missing",
        "changed",
        "unverified"
      ]
    },
    "ArtifactManifestItem": {
      "type": "object",
      "properties": {
        "availability": {
          "$ref": "#/$defs/ArtifactAvailability"
        },
        "ordinal": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "reference_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "ordinal",
        "reference_id",
        "availability"
      ]
    },
    "AttemptResult": {
      "type": "object",
      "properties": {
        "action_succeeded": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "attempt_id": {
          "type": "string"
        },
        "host_session_id": {
          "type": "string"
        },
        "observe_valid": {
          "type": "boolean"
        },
        "phase": {
          "$ref": "#/$defs/AttemptResultPhase"
        },
        "step_id": {
          "type": "string"
        },
        "unknown_reason": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptUnknownReason"
            },
            {
              "type": "null"
            }
          ]
        },
        "worker_instance_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "step_id",
        "attempt_id",
        "worker_instance_id",
        "host_session_id",
        "phase",
        "observe_valid"
      ]
    },
    "AttemptResultPhase": {
      "type": "string",
      "enum": [
        "observed",
        "unknown"
      ]
    },
    "AttemptStarted": {
      "type": "object",
      "properties": {
        "attempt_id": {
          "type": "string"
        },
        "host_session_id": {
          "type": "string"
        },
        "step_id": {
          "type": "string"
        },
        "worker_instance_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "step_id",
        "attempt_id",
        "worker_instance_id",
        "host_session_id"
      ]
    },
    "AttemptUnknownReason": {
      "type": "string",
      "enum": [
        "invalid-input",
        "dependency-unavailable",
        "worker-failed",
        "timed-out",
        "invalid-response",
        "identity-mismatch",
        "observe-failed",
        "user-input"
      ]
    },
    "Availability": {
      "type": "string",
      "enum": [
        "available",
        "permission_required",
        "dependency_missing",
        "temporarily_unavailable"
      ]
    },
    "BrowserReference": {
      "type": "object",
      "properties": {
        "external_task_ref": {
          "type": "string"
        },
        "finished": {
          "type": "boolean"
        },
        "managed_pages": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "ownership": {
          "type": "string"
        },
        "updated_sequence": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "external_task_ref",
        "ownership",
        "managed_pages",
        "finished",
        "updated_sequence"
      ]
    },
    "Capability": {
      "type": "string",
      "enum": [
        "task.read",
        "task.create",
        "task.cancel",
        "task.complete",
        "task.fail",
        "task.control",
        "task.wait-for-user",
        "task.step.declare",
        "task.step.advance",
        "browser.execute",
        "computer.execute",
        "file.grant.read",
        "file.execute",
        "document.execute",
        "command.propose",
        "command.execute"
      ]
    },
    "CapabilityInfo": {
      "type": "object",
      "properties": {
        "availability": {
          "$ref": "#/$defs/Availability"
        },
        "name": {
          "$ref": "#/$defs/Capability"
        },
        "reason": {
          "type": [
            "string",
            "null"
          ]
        },
        "version": {
          "$ref": "#/$defs/ProtocolVersion"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "version",
        "availability",
        "reason"
      ]
    },
    "ComputerObservation": {
      "type": "object",
      "properties": {
        "element_count": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "screenshot_mime": {
          "type": [
            "string",
            "null"
          ]
        },
        "screenshot_path": {
          "type": [
            "string",
            "null"
          ]
        },
        "target_visible": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "element_count",
        "screenshot_path",
        "screenshot_mime",
        "target_visible"
      ]
    },
    "ControlEvent": {
      "type": "object",
      "properties": {
        "attempt_id": {
          "type": "string"
        },
        "control_id": {
          "type": "string"
        },
        "kind": {
          "$ref": "#/$defs/ControlKind"
        },
        "phase": {
          "$ref": "#/$defs/ControlPhase"
        }
      },
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "control_id",
        "kind",
        "phase"
      ]
    },
    "ControlKind": {
      "type": "string",
      "enum": [
        "pause",
        "cancel",
        "takeover"
      ]
    },
    "ControlPhase": {
      "type": "string",
      "enum": [
        "pending",
        "stopped"
      ]
    },
    "ControlRecord": {
      "type": "object",
      "properties": {
        "accepted_sequence": {
          "type": "string"
        },
        "attempt_id": {
          "type": "string"
        },
        "control_id": {
          "type": "string"
        },
        "focus_failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/FocusFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "focus_phase": {
          "anyOf": [
            {
              "$ref": "#/$defs/FocusPhase"
            },
            {
              "type": "null"
            }
          ]
        },
        "kind": {
          "$ref": "#/$defs/ControlKind"
        },
        "phase": {
          "$ref": "#/$defs/ControlPhase"
        },
        "stopped_sequence": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "attempt_id",
        "control_id",
        "kind",
        "phase",
        "accepted_sequence",
        "stopped_sequence"
      ]
    },
    "DocumentExecutionResult": {
      "type": "object",
      "properties": {
        "attempt_result": {
          "$ref": "#/$defs/AttemptResult"
        },
        "bytes_written": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "format": {
          "anyOf": [
            {
              "$ref": "#/$defs/DocumentFormat"
            },
            {
              "type": "null"
            }
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "task": {
          "$ref": "#/$defs/TaskSnapshot"
        }
      },
      "additionalProperties": false,
      "required": [
        "task",
        "attempt_result",
        "format",
        "sha256",
        "bytes_written"
      ]
    },
    "DocumentFormat": {
      "type": "string",
      "enum": [
        "docx",
        "xlsx",
        "pptx"
      ]
    },
    "FileExecutionResult": {
      "type": "object",
      "properties": {
        "attempt_result": {
          "$ref": "#/$defs/AttemptResult"
        },
        "bytes_written": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "data_base64": {
          "type": [
            "string",
            "null"
          ]
        },
        "sha256": {
          "type": [
            "string",
            "null"
          ]
        },
        "task": {
          "$ref": "#/$defs/TaskSnapshot"
        }
      },
      "additionalProperties": false,
      "required": [
        "task",
        "attempt_result"
      ]
    },
    "FileGrantPurpose": {
      "type": "string",
      "enum": [
        "read",
        "create-new",
        "replace",
        "trash"
      ]
    },
    "FileGrantSummary": {
      "type": "object",
      "properties": {
        "expires_at_ms": {
          "type": "integer",
          "format": "uint64",
          "maximum": 9007199254740991,
          "minimum": 0
        },
        "grant_id": {
          "type": "string"
        },
        "purpose": {
          "$ref": "#/$defs/FileGrantPurpose"
        }
      },
      "additionalProperties": false,
      "required": [
        "grant_id",
        "purpose",
        "expires_at_ms"
      ]
    },
    "FocusEvent": {
      "type": "object",
      "properties": {
        "control_id": {
          "type": "string"
        },
        "failure": {
          "anyOf": [
            {
              "$ref": "#/$defs/FocusFailure"
            },
            {
              "type": "null"
            }
          ]
        },
        "phase": {
          "$ref": "#/$defs/FocusPhase"
        }
      },
      "additionalProperties": false,
      "required": [
        "control_id",
        "phase"
      ]
    },
    "FocusFailure": {
      "type": "string",
      "enum": [
        "permission-unavailable",
        "process-changed",
        "window-missing",
        "mapping-not-unique",
        "activation-failed",
        "verification-failed",
        "geometry-changed",
        "reference-unavailable"
      ]
    },
    "FocusPhase": {
      "type": "string",
      "enum": [
        "locating",
        "focused",
        "failed"
      ]
    },
    "Platform": {
      "type": "string",
      "enum": [
        "windows",
        "macos"
      ]
    },
    "ProtocolVersion": {
      "type": "object",
      "properties": {
        "major": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "minor": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "major",
        "minor"
      ]
    },
    "QueryResult": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "capabilities": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/CapabilityInfo"
              }
            },
            "kind": {
              "type": "string",
              "const": "hello"
            },
            "platform": {
              "$ref": "#/$defs/Platform"
            },
            "protocol_version": {
              "$ref": "#/$defs/ProtocolVersion"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "protocol_version",
            "platform",
            "capabilities"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "tasks"
            },
            "next_after_task_id": {
              "type": [
                "string",
                "null"
              ]
            },
            "tasks": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TaskSnapshot"
              }
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "tasks",
            "next_after_task_id"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "snapshot"
            },
            "task": {
              "$ref": "#/$defs/TaskSnapshot"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "task"
          ]
        },
        {
          "type": "object",
          "properties": {
            "events": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/TaskEvent"
              }
            },
            "kind": {
              "type": "string",
              "const": "events"
            },
            "task_id": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "task_id",
            "events"
          ]
        },
        {
          "type": "object",
          "properties": {
            "items": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/ArtifactManifestItem"
              }
            },
            "kind": {
              "type": "string",
              "const": "artifact-manifest-page"
            },
            "manifest_version": {
              "type": "string"
            },
            "next_after_ordinal": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint16",
              "maximum": 65535,
              "minimum": 0
            },
            "task_id": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "task_id",
            "manifest_version",
            "items"
          ]
        },
        {
          "type": "object",
          "properties": {
            "grants": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/FileGrantSummary"
              }
            },
            "kind": {
              "type": "string",
              "const": "file-grants"
            },
            "task_id": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "task_id",
            "grants"
          ]
        },
        {
          "type": "object",
          "properties": {
            "execution": {
              "$ref": "#/$defs/FileExecutionResult"
            },
            "kind": {
              "type": "string",
              "const": "file-execution"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "execution"
          ]
        },
        {
          "type": "object",
          "properties": {
            "execution": {
              "$ref": "#/$defs/DocumentExecutionResult"
            },
            "kind": {
              "type": "string",
              "const": "document-execution"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "execution"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "step"
            },
            "step": {
              "anyOf": [
                {
                  "$ref": "#/$defs/StepDeclaration"
                },
                {
                  "type": "null"
                }
              ]
            },
            "task": {
              "$ref": "#/$defs/TaskSnapshot"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "task",
            "step"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "browser-state"
            },
            "reference": {
              "anyOf": [
                {
                  "$ref": "#/$defs/BrowserReference"
                },
                {
                  "type": "null"
                }
              ]
            },
            "task": {
              "$ref": "#/$defs/TaskSnapshot"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "task",
            "reference"
          ]
        },
        {
          "type": "object",
          "properties": {
            "control": {
              "$ref": "#/$defs/ControlRecord"
            },
            "kind": {
              "type": "string",
              "const": "control"
            },
            "task": {
              "$ref": "#/$defs/TaskSnapshot"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "task",
            "control"
          ]
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "type": "string",
              "const": "browser"
            },
            "reference": {
              "$ref": "#/$defs/BrowserReference"
            },
            "task": {
              "$ref": "#/$defs/TaskSnapshot"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "task",
            "reference"
          ]
        },
        {
          "type": "object",
          "properties": {
            "attempt_result": {
              "$ref": "#/$defs/AttemptResult"
            },
            "kind": {
              "type": "string",
              "const": "computer"
            },
            "task": {
              "$ref": "#/$defs/TaskSnapshot"
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "task",
            "attempt_result"
          ]
        },
        {
          "type": "object",
          "properties": {
            "action_succeeded": {
              "type": [
                "boolean",
                "null"
              ]
            },
            "kind": {
              "type": "string",
              "const": "computer-step"
            },
            "observation": {
              "anyOf": [
                {
                  "$ref": "#/$defs/ComputerObservation"
                },
                {
                  "type": "null"
                }
              ]
            },
            "sequence": {
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/TaskStatus"
            },
            "task_id": {
              "type": "string"
            },
            "unknown_reason": {
              "anyOf": [
                {
                  "$ref": "#/$defs/AttemptUnknownReason"
                },
                {
                  "type": "null"
                }
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "kind",
            "task_id",
            "status",
            "sequence",
            "action_succeeded",
            "unknown_reason",
            "observation"
          ]
        }
      ]
    },
    "RpcError": {
      "type": "object",
      "properties": {
        "code": {
          "type": "integer",
          "format": "int32"
        },
        "message": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "code",
        "message"
      ]
    },
    "StepDeclaration": {
      "type": "object",
      "properties": {
        "accepted_sequence": {
          "type": "string"
        },
        "label": {
          "type": "string"
        },
        "step_id": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "step_id",
        "label",
        "accepted_sequence"
      ]
    },
    "TaskArtifactManifest": {
      "type": "object",
      "properties": {
        "item_count": {
          "type": "integer",
          "format": "uint16",
          "maximum": 65535,
          "minimum": 0
        },
        "task_id": {
          "type": "string"
        },
        "version": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "task_id",
        "version",
        "item_count"
      ]
    },
    "TaskCreationEvent": {
      "type": "object",
      "properties": {
        "owner_agent_id": {
          "type": "string"
        },
        "source": {
          "$ref": "#/$defs/TaskSource"
        }
      },
      "additionalProperties": false,
      "required": [
        "owner_agent_id",
        "source"
      ]
    },
    "TaskEvent": {
      "type": "object",
      "properties": {
        "artifact_manifest": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskArtifactManifest"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt_result": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptResult"
            },
            {
              "type": "null"
            }
          ]
        },
        "attempt_started": {
          "anyOf": [
            {
              "$ref": "#/$defs/AttemptStarted"
            },
            {
              "type": "null"
            }
          ]
        },
        "control_event": {
          "anyOf": [
            {
              "$ref": "#/$defs/ControlEvent"
            },
            {
              "type": "null"
            }
          ]
        },
        "creation_event": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskCreationEvent"
            },
            {
              "type": "null"
            }
          ]
        },
        "focus_event": {
          "anyOf": [
            {
              "$ref": "#/$defs/FocusEvent"
            },
            {
              "type": "null"
            }
          ]
        },
        "observation": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskObservation"
            },
            {
              "type": "null"
            }
          ]
        },
        "previous": {
          "$ref": "#/$defs/TaskStatus"
        },
        "sequence": {
          "type": "string"
        },
        "status": {
          "$ref": "#/$defs/TaskStatus"
        },
        "step_declaration": {
          "anyOf": [
            {
              "$ref": "#/$defs/StepDeclaration"
            },
            {
              "type": "null"
            }
          ]
        },
        "user_confirmation": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskUserConfirmation"
            },
            {
              "type": "null"
            }
          ]
        },
        "wait_reason": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "previous",
        "status",
        "sequence"
      ]
    },
    "TaskObservation": {
      "type": "object",
      "properties": {
        "result": {
          "$ref": "#/$defs/TaskObservationResult"
        },
        "step_id": {
          "type": "string"
        },
        "summary": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "step_id",
        "result",
        "summary"
      ]
    },
