{
  "description": "在 Codex CLI 会话启动或恢复时运行 Yonder 托管连接器。",
  "hooks": {
    "SessionStart": [
      {
        "matcher": "^(startup|resume)$",
        "hooks": [
          {
            "type": "command",
            "command": "\"${PLUGIN_ROOT}/scripts/connect.sh\"",
            "async": true,
            "timeout": 86400,
            "statusMessage": "正在连接 Yonder"
          }
        ]
      }
    ]
  }
}
