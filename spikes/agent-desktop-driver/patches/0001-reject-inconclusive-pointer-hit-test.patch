+#[test]
+fn unknown_pointer_hit_test_rejects_before_delivery() {
+    let adapter = HitTestAdapter {
+        outcome: Ok(HitTestResult::Unknown),
+        actions: Vec::new(),
+        calls: AtomicUsize::new(0),
+    };
+    let error = crate::actionability::require_receives_events(
+        &NativeHandle::null(),
+        crate::Point { x: 30.0, y: 20.0 },
+        &adapter,
+        crate::Deadline::standard().unwrap(),
+    )
+    .expect_err("unknown hit test must block pointer delivery");
+    assert_eq!(error.code, ErrorCode::ActionFailed);
+    assert_eq!(error.disposition, crate::DeliverySemantics::not_delivered());
+}
+
+#[test]
+fn unsupported_pointer_hit_test_rejects_before_delivery() {
+    let adapter = HitTestAdapter {
+        outcome: Err(AdapterError::not_supported("hit_test")),
+        actions: Vec::new(),
+        calls: AtomicUsize::new(0),
+    };
+    let error = crate::actionability::require_receives_events(
+        &NativeHandle::null(),
+        crate::Point { x: 30.0, y: 20.0 },
+        &adapter,
+        crate::Deadline::standard().unwrap(),
+    )
+    .expect_err("unsupported hit test must block pointer delivery");
+    assert_eq!(error.code, ErrorCode::ActionFailed);
+    assert_eq!(error.disposition, crate::DeliverySemantics::not_delivered());
+}
