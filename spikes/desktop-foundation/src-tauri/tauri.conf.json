{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Yonder E0",
  "version": "0.0.0",
  "identifier": "com.yonder.e0-spike",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [
      {
        "label": "pet",
        "title": "Yonder E0",
        "width": 180,
        "height": 180,
        "transparent": true,
        "decorations": false,
        "alwaysOnTop": true,
        "resizable": false
      }
    ],
    "security": {
      "capabilities": [{
        "identifier": "pet-drag",
        "description": "仅允许本地桌宠窗口使用原生拖动",
        "local": true,
        "windows": ["pet"],
        "permissions": ["core:window:allow-start-dragging"]
      }],
      "csp": "default-src 'self'; style-src 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": false,
    "icon": ["icons/icon.png"]
  }
}
