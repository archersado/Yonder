{
  "manifest_version": 3,
  "name": "Yonder 上下文通道验证",
  "version": "0.0.1",
  "key": "",
  "permissions": ["nativeMessaging", "tabs", "storage"],
  "background": { "service_worker": "service-worker.js" },
  "action": { "default_title": "开始/停止 Yonder Record" },
  "commands": {
    "_execute_action": {
      "suggested_key": { "default": "Ctrl+Shift+Y" },
      "description": "开始或停止 Yonder Record"
    }
  },
  "incognito": "split"
}
